diff --git a/web/tests/e2e/newsletter-layout.spec.ts b/web/tests/e2e/newsletter-layout.spec.ts
new file mode 100644
index 0000000..f2c8726
--- /dev/null
+++ b/web/tests/e2e/newsletter-layout.spec.ts
@@ -0,0 +1,54 @@
+import { expect, test, type Page } from "@playwright/test";
+import { EDICOES_PUBLICAS } from "../../src/features/newsletter/catalog";
+
+const INNER = 1200;
+
+async function width(page: Page, selector: string) {
+  const box = await page.locator(selector).first().boundingBox();
+  if (!box) throw new Error(`sem caixa para ${selector}`);
+  return Math.round(box.width);
+}
+
+test.describe("desktop 1440", () => {
+  test.use({ viewport: { width: 1440, height: 900 } });
+
+  test("arquivo: abertura, destaque e lista usam toda a largura útil", async ({ page }) => {
+    await page.goto("/newsletter/edicoes");
+    const heroText = page.locator("section[aria-labelledby='titulo'] > div > div").first();
+    expect(Math.round((await heroText.boundingBox())!.width)).toBe(INNER);
+    expect(await width(page, "#destaque >> xpath=ancestor::section[1]")).toBe(INNER);
+    expect(await width(page, "ol > li article")).toBe(INNER);
+    const lead = Math.round((await page.locator("section[aria-labelledby='titulo'] p").first().boundingBox())!.width);
+    const h1 = Math.round((await page.locator("#titulo").boundingBox())!.width);
+    expect(h1 + lead).toBeGreaterThan(INNER / 2 + 400);
+  });
+
+  for (const edicao of EDICOES_PUBLICAS) {
+    test(`prévia ${edicao.slug}: artigo, título e card em toda a largura, parágrafo legível`, async ({ page }) => {
+      await page.goto(`/newsletter/edicoes/${edicao.slug}`);
+      expect(await width(page, "article[aria-labelledby='titulo']")).toBe(INNER);
+      expect(await width(page, "#titulo")).toBe(INNER);
+      expect(await width(page, "#receba >> xpath=ancestor::div[1]")).toBe(INNER);
+      const paragraph = await width(page, "article[aria-labelledby='titulo'] > p:last-child");
+      expect(paragraph).toBeLessThan(INNER);
+      expect(paragraph).toBeLessThanOrEqual(820);
+    });
+  }
+
+  test("landing /newsletter mantém o bloco de abertura limitado", async ({ page }) => {
+    await page.goto("/newsletter");
+    expect(await width(page, "section[aria-labelledby='titulo'] p")).toBeLessThanOrEqual(560);
+  });
+});
+
+for (const vw of [320, 390]) {
+  test(`arquivo e prévias sem overflow em ${vw}px`, async ({ page }) => {
+    await page.setViewportSize({ width: vw, height: 844 });
+    for (const path of ["/newsletter/edicoes", ...EDICOES_PUBLICAS.map((e) => `/newsletter/edicoes/${e.slug}`)]) {
+      await page.goto(path);
+      await expect(page.getByRole("heading", { level: 1 })).toBeVisible();
+      const overflow = await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth);
+      expect(overflow, path).toBeLessThanOrEqual(0);
+    }
+  });
+}
diff --git a/web/tests/unit/font-assets.test.ts b/web/tests/unit/font-assets.test.ts
new file mode 100644
index 0000000..2c20f05
--- /dev/null
+++ b/web/tests/unit/font-assets.test.ts
@@ -0,0 +1,46 @@
+import { createHash } from "node:crypto";
+import { readdirSync, readFileSync, statSync } from "node:fs";
+import { createRequire } from "node:module";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+
+interface FontFace { characterSet: number[]; variationAxes: Record<string, { min: number; max: number; default: number }> }
+const parseFont = createRequire(import.meta.url)("next/dist/compiled/@next/font/dist/fontkit").default as (buffer: Buffer) => FontFace;
+
+const fontsDir = join(__dirname, "../../src/assets/fonts");
+const srcDir = join(__dirname, "../../src");
+const audit = JSON.parse(readFileSync(join(__dirname, "../../../references/audits/font-optimization.json"), "utf8")) as { fonts: Array<{ ttf: string; woff2: string; sha256: string; bytes: number; version: string; axes: Record<string, [number, number]> }> };
+
+function sourceCodePoints(dir: string, found = new Set<number>()): Set<number> {
+  for (const name of readdirSync(dir)) {
+    const path = join(dir, name);
+    if (statSync(path).isDirectory()) sourceCodePoints(path, found);
+    else if (/\.(tsx?|css|json|md)$/.test(name)) for (const char of readFileSync(path, "utf8")) found.add(char.codePointAt(0)!);
+  }
+  return found;
+}
+
+describe("optimized Latin WOFF2 fonts", () => {
+  const used = sourceCodePoints(srcDir);
+  for (const entry of audit.fonts) {
+    const original = parseFont(readFileSync(join(fontsDir, entry.ttf)));
+    const bytes = readFileSync(join(fontsDir, entry.woff2));
+    const optimized = parseFont(bytes);
+
+    it(`${entry.woff2} matches the audited hash and size`, () => {
+      expect(createHash("sha256").update(bytes).digest("hex")).toBe(entry.sha256);
+      expect(bytes.length).toBe(entry.bytes);
+    });
+    it(`${entry.woff2} keeps the weight axis and a fixed default width`, () => {
+      for (const [axis, [min, max]] of Object.entries(entry.axes)) expect(optimized.variationAxes[axis]).toMatchObject({ min, max });
+      expect(Object.keys(optimized.variationAxes).sort()).toEqual(Object.keys(entry.axes).sort());
+      expect(optimized.variationAxes.wght.default).toBe(original.variationAxes.wght.default);
+    });
+    it(`${entry.woff2} covers every source character the original TTF supports`, () => {
+      const originalSet = new Set(original.characterSet);
+      const optimizedSet = new Set(optimized.characterSet);
+      const lost = [...used].filter((cp) => originalSet.has(cp) && !optimizedSet.has(cp)).map((cp) => `U+${cp.toString(16).toUpperCase().padStart(4, "0")}`);
+      expect(lost).toEqual([]);
+    });
+  }
+});
