{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/pecas-digitais/**",
              "components/selos/**",
              "components/simbolo/**",
              "ui_kits/manual-de-marca/**",
              "ui_kits/pecas-digitais/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Baloo 2|Archivo))/i]",
        "message": "Font not provided by the design system. Available: Baloo 2, Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssinaturaDeEMail600px'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|text2|text3|text4|key|ref|className|style|children)$/]",
        "message": "<AssinaturaDeEMail600px> doesn't accept that prop. Declared props: className, style, text1, text2, text3, text4."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssinaturaFaixa'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|key|ref|className|style|children)$/]",
        "message": "<AssinaturaFaixa> doesn't accept that prop. Declared props: className, style, text1."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssinaturaSimbolo'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|icon1|key|ref|className|style|children)$/]",
        "message": "<AssinaturaSimbolo> doesn't accept that prop. Declared props: className, style, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkedInBannerDaPGina'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|text2|text3|text4|icon1|icon2|icon3|key|ref|className|style|children)$/]",
        "message": "<LinkedInBannerDaPGina> doesn't accept that prop. Declared props: className, style, text1, text2, text3, text4, icon1, icon2, icon3."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkedInBannerPessoal1584x396'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|text2|text3|key|ref|className|style|children)$/]",
        "message": "<LinkedInBannerPessoal1584x396> doesn't accept that prop. Declared props: className, style, text1, text2, text3."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeloRoottrustCompactoClaro'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|icon1|key|ref|className|style|children)$/]",
        "message": "<SeloRoottrustCompactoClaro> doesn't accept that prop. Declared props: className, style, text1, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeloRoottrustCompactoEscuro'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|icon1|key|ref|className|style|children)$/]",
        "message": "<SeloRoottrustCompactoEscuro> doesn't accept that prop. Declared props: className, style, text1, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeloRoottrustHorizontalClaro'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|text2|icon1|key|ref|className|style|children)$/]",
        "message": "<SeloRoottrustHorizontalClaro> doesn't accept that prop. Declared props: className, style, text1, text2, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeloRoottrustHorizontalEscuro'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|text2|icon1|key|ref|className|style|children)$/]",
        "message": "<SeloRoottrustHorizontalEscuro> doesn't accept that prop. Declared props: className, style, text1, text2, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeloRoottrustRedondoClaro'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|text2|text3|text4|icon1|key|ref|className|style|children)$/]",
        "message": "<SeloRoottrustRedondoClaro> doesn't accept that prop. Declared props: className, style, text1, text2, text3, text4, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeloRoottrustRedondoEscuro'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|text2|text3|text4|icon1|key|ref|className|style|children)$/]",
        "message": "<SeloRoottrustRedondoEscuro> doesn't accept that prop. Declared props: className, style, text1, text2, text3, text4, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='SMboloRaiz'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<SMboloRaiz> doesn't accept that prop. Declared props: className, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
